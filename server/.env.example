# Pi-Chat Server Configuration
# NOTE: 与仓库根目录 .env.example 保持一致，新增环境变量请同步两处。
PORT=3000
HOST=0.0.0.0
AUTH_TOKEN=
# PI_AUTH_TOKEN=
# PI_BIN=/usr/local/bin/pi
# PI_SESSIONS_DIR=~/.pi/agent/sessions
IDLE_TIMEOUT_MS=1800000
PI_CACHE_RETENTION=long
# MAX_AGENT_LIFETIME_MS=0
# EVENT_BUFFER_SIZE=5000
# IDLE_DROP_HEAP=false
MAX_CONCURRENT_AGENTS=0
# ALLOWED_ORIGINS=
# Comma-separated list of allowed cwd root dirs. If set, cwd requests outside these roots are rejected. If empty, all cwd values are allowed.
# ALLOWED_CWD_DIRS=/home/user/projects,/home/user/repos
# Timeout (ms) for long-running commands (prompt, steer, client_send) before resetting streaming state (defaults to 10 mins = 600000, 0 = wait forever)
# LONG_RUNNING_TIMEOUT_MS=600000
