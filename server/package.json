{
  "name": "@liguoshuai/pi-chat-server",
  "version": "2.0.0",
  "description": "Pi Agent Gateway server for VPS hosting, bridging Web, Android, and HarmonyOS native apps to pi coding agent subprocesses",
  "type": "module",
  "main": "src/server.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/server.js",
    "./config": "./src/config.js",
    "./auth": "./src/auth.js",
    "./agent": "./src/agent.js",
    "./ws": "./src/ws.js",
    "./sse": "./src/sse.js",
    "./routes": "./src/routes.js"
  },
  "bin": {
    "pi-chat-server": "src/index.js"
  },
  "files": [
    "src/",
    "scripts/",
    "README.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test"
  },
  "keywords": [
    "pi-chat",
    "gateway",
    "rpc",
    "websocket",
    "sse",
    "vps"
  ],
  "author": "Guoshuai Li",
  "license": "MIT",
  "dependencies": {
    "@liguoshuai/pi-chat-protocol": "workspace:*",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  }
}
