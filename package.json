{
  "name": "pi-chat",
  "version": "1.0.0",
  "private": true,
  "description": "pi-chat — Monorepo for multi-client Pi coding agent ecosystem (Web, Android, HarmonyOS, Server Gateway, Protocol)",
  "type": "module",
  "scripts": {
    "start": "pnpm --filter @liguoshuai/pi-web-chat start",
    "start:web": "pnpm --filter @liguoshuai/pi-web-chat start",
    "start:server": "pnpm --filter @pi-chat/server start",
    "dev": "pnpm --filter @liguoshuai/pi-web-chat dev",
    "dev:web": "pnpm --filter @liguoshuai/pi-web-chat dev",
    "dev:server": "pnpm --filter @pi-chat/server dev",
    "test": "pnpm -r --filter @pi-chat/protocol --filter @pi-chat/server --filter @liguoshuai/pi-web-chat test",
    "test:web": "pnpm --filter @liguoshuai/pi-web-chat test",
    "test:server": "pnpm --filter @pi-chat/server test",
    "test:protocol": "pnpm --filter @pi-chat/protocol test",
    "publish:web": "pnpm --filter @liguoshuai/pi-web-chat publish"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "chat",
    "monorepo",
    "web",
    "android",
    "harmony",
    "gateway"
  ],
  "author": "Guoshuai Li",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
