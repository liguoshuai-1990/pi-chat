{
  "name": "pi-chat",
  "version": "2.15.5",
  "private": true,
  "description": "pi-chat — Monorepo for multi-client Pi coding agent ecosystem (Web, Android, HarmonyOS, Server Gateway, Protocol)",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter @liguoshuai/pi-chat-protocol --filter @liguoshuai/pi-chat-server --filter @liguoshuai/pi-web-chat build",
    "check": "pnpm build && pnpm test",
    "build:android": "cd clients/android && ./gradlew assembleDebug",
    "build:all": "pnpm check && pnpm build:android",
    "start": "pnpm --filter @liguoshuai/pi-web-chat start",
    "start:web": "pnpm --filter @liguoshuai/pi-web-chat start",
    "start:server": "pnpm --filter @liguoshuai/pi-chat-server start",
    "dev": "pnpm --filter @liguoshuai/pi-web-chat dev",
    "dev:web": "pnpm --filter @liguoshuai/pi-web-chat dev",
    "dev:server": "pnpm --filter @liguoshuai/pi-chat-server dev",
    "test": "pnpm -r --filter @liguoshuai/pi-chat-protocol --filter @liguoshuai/pi-chat-server --filter @liguoshuai/pi-web-chat test",
    "test:web": "pnpm --filter @liguoshuai/pi-web-chat test",
    "test:server": "pnpm --filter @liguoshuai/pi-chat-server test",
    "test:protocol": "pnpm --filter @liguoshuai/pi-chat-protocol test",
    "pack:all": "pnpm -r exec pnpm pack",
    "publish:all": "pnpm -r publish --access public --no-git-checks",
    "publish:web": "pnpm --filter @liguoshuai/pi-web-chat publish"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "chat",
    "monorepo",
    "web",
    "android",
    "harmony",
    "gateway"
  ],
  "author": "Guoshuai Li",
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
