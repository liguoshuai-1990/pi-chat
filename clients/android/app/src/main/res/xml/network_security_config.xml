<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Pi Gateway runs plain HTTP (no TLS) by design — it is a LAN/local
        development tool, not a public internet service.  Requiring HTTPS
        would mean every user must provision certificates for their local
        server, which is impractical.

        The previous config only allowed cleartext for 10.0.2.2 / localhost /
        127.0.0.1 (emulator loopback), which silently blocked real devices
        connecting to a LAN server (e.g. http://192.168.1.100:3000).

        Allow cleartext for all hosts so real phones can reach the gateway.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
