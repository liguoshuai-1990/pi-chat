{
  "name": "@liguoshuai/pi-web-chat",
  "version": "2.14.14",
  "description": "A ChatGPT/Gemini-style web UI for the pi coding agent, powered by pi's RPC mode.",
  "type": "module",
  "main": "server.js",
  "bin": {
    "pi-web-chat": "bin/pi-web-chat.js"
  },
  "files": [
    "server.js",
    "bin/",
    "public/",
    "docs/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --check server.js && node --check bin/pi-web-chat.js && node --check public/app.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "prepare": "node -e \"import('fs').then(fs => { try { fs.chmodSync('bin/pi-web-chat.js', 0o755); } catch {} })\""
  },
  "keywords": [
    "pi",
    "coding-agent",
    "chat",
    "web-ui",
    "rpc",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liguoshuai-1990/pi-chat.git"
  },
  "bugs": {
    "url": "https://github.com/liguoshuai-1990/pi-chat/issues"
  },
  "homepage": "https://github.com/liguoshuai-1990/pi-chat#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@liguoshuai/pi-chat-protocol": "workspace:*",
    "@liguoshuai/pi-chat-server": "workspace:*",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  }
}
