# Pi-Chat Gateway Server Environment Variables

# Network & Server Port
PORT=3000
HOST=0.0.0.0

# Security & Authentication (Leave empty to disable authentication for local dev)
AUTH_TOKEN=
# Legacy alias for AUTH_TOKEN (AUTH_TOKEN takes precedence)
# PI_AUTH_TOKEN=

# Path to pi coding agent executable (auto-detected if in PATH)
# PI_BIN=/usr/local/bin/pi

# Path to pi session storage directory (defaults to ~/.pi/agent/sessions)
# PI_SESSIONS_DIR=~/.pi/agent/sessions

# Idle timeout in ms before terminating idle background agent processes (5 mins = 300000)
IDLE_TIMEOUT_MS=300000

# Maximum concurrent background agents (0 = unlimited)
MAX_CONCURRENT_AGENTS=0

# Hard upper bound (ms) for a single background agent's lifetime (0 = disabled)
# MAX_AGENT_LIFETIME_MS=0

# Ring-buffer capacity for offline event replay (defaults to 5000)
# EVENT_BUFFER_SIZE=5000

# Hint V8 GC when an agent goes idle (requires node --expose-gc)
# IDLE_DROP_HEAP=false

# Allowed CORS/WebSocket Origins (comma-separated, empty = allow localhost/same-origin)
# ALLOWED_ORIGINS=https://chat.example.com,http://localhost:3000
